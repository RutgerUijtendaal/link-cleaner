{
    "manifest_version": 3,
    "name": "Link Cleaner",
    "version": "0.1.2",
    "description": "Automatically removes tracking parameters from YouTube links on the pages you browse.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
